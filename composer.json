{
    "name": "theriddleofenigma/laravel-rache",
    "description": "A super cool package for caching the laravel response dynamically.",
    "keywords": [
        "laravel",
        "lumen",
        "cache",
        "response-cache",
        "http-cache",
        "middleware"
    ],
    "homepage": "https://github.com/theriddleofenigma/laravel-rache",
    "license": "MIT",
    "authors": [
        {
            "name": "Kumaravel",
            "email": "kumarwindows11@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/theriddleofenigma/laravel-rache/issues",
        "source": "https://github.com/theriddleofenigma/laravel-rache"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.17|^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Rache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rache\\RacheServiceProvider"
            ],
            "aliases": {
                "Rache": "Rache\\Facades\\Rache"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
